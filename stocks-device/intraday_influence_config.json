  "response_horizons_minutes": [5, 10, 15, 30, 60, 120],
  "walk_forward": {"train_sessions": 20, "test_sessions": 5, "step_sessions": 5,
    "purge_minutes": 30, "embargo_sessions": 1, "ridge_alphas": [0.01, 0.1, 1.0, 10.0]},
  "fdr_alpha": 0.05,
  "random_seed": 20260805,
  "output_root": "research_intraday"
