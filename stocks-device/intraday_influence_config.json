{
  "engine_version": "3B.1",
  "symbols": ["NVDA", "MRVL", "AMD", "AVGO", "COHR", "AAOI", "QCOM", "ANET", "MU"],
  "controls": ["SPY", "QQQ", "SMH", "SOXX"],
  "include_controls_as_targets": false,
  "intervals": ["5m", "15m", "30m", "60m"],
  "analysis_intervals": ["5m", "15m", "30m", "60m"],
  "market_benchmark": "SPY",
  "sector_benchmark": "SMH",
  "regular_session_only": true,
